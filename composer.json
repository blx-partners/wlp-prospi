{
  "name": "blx/wlp-prospi",
  "description": "ProSPI: Kursliste des SPI-Orientierungsplans (Liste, Filter, Detail) für TYPO3",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Robert Kraemer",
      "email": "robert.kraemer@blx.partners",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4",
    "typo3/cms-extbase": "^13.4",
    "typo3/cms-fluid": "^13.4",
    "typo3/cms-frontend": "^13.4",
    "typo3/cms-install": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Blx\\WlpProspi\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "wlp_prospi"
    }
  }
}
